ref table Dim_Store
ref table Fact_Sales
ref table _DAX
ref table 'City - State Lookup Table'
ref table ClusterMappingTable
ref table 'Profit Field Param'
ref table 'Revenue/Sales vs Profit Param'

ref cultureInfo en-US

