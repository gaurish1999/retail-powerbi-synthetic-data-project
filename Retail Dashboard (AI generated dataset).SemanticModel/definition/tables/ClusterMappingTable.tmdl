table ClusterMappingTable
	isHidden
	isPrivate
	lineageTag: 75a70233-088f-4c3c-a304-dde7d0d5fe37

	column Product_Name
		lineageTag: a7fbaad5-f134-45cd-8232-68e6c6f626e1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product_Name]

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Dim_Product","TableItemName":"Product Name (clusters)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column ClusterId
		formatString: 0
		lineageTag: 35f17f32-609a-4af3-9c37-3591694a54fa
		summarizeBy: count
		isNameInferred
		sourceColumn: [ClusterId]

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Dim_Product","TableItemName":"Product Name (clusters)","ObjectType":4},"LinkType":"UsedInGroup"}]

	partition ClusterMappingTable = calculated
		mode: import
		source = ```
				VAR __DS0FilterTable = 
					TREATAS({"2022",
						"2023",
						"2024"}, 'Dim_Date'[Year])
				
				VAR __DS0Core = 
					SUMMARIZECOLUMNS(
						'Dim_Product'[Product Name],
						__DS0FilterTable,
						"AverageDiscount__", CALCULATE(AVERAGE('Fact_Sales'[Discount %])),
						"v__of_Total_Profit", '_DAX'[% of Total Profit]
					)
				
				VAR __DataTransformT0 = 
					KMeansClustering(
						SELECTCOLUMNS(
							__DS0Core,
							"Product_Name", 'Dim_Product'[Product Name],
							"AverageDiscount__", [AverageDiscount__],
							"v__of_Total_Profit", [v__of_Total_Profit]
						),
						{("[Product_Name]", "Item"),
							("[AverageDiscount__]", "Attribute"),
							("[v__of_Total_Profit]", "Attribute")},
						{("[Product_Name]", BLANK()),
							("ClusterId", "ClusterId")},
						3
					)
				
				RETURN __DataTransformT0
				```
			retainDataTillForceCalculate

	annotation ClusterMappingTable = true

	annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Dim_Product","TableItemName":"Product Name (clusters)","ObjectType":4},"LinkType":"UsedInGroup"}]

